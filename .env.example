# ATHLEO local environment template
# Copy this file to .env and fill in your real values.
# Never commit .env to git.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=replace-with-your-project-jwt-secret

# Optional feature flags / external integrations
OPENAI_API_KEY=your-openai-key
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
REVENUECAT_API_KEY=your-revenuecat-key
EDGE_FUNCTION_SECRET=super-secret-edge-key

# App runtime
APP_ENV=development
DEBUG_MODE=true
